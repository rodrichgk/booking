# Database (Required)
# Get from: https://neon.tech or https://vercel.com/storage/postgres
# Vercel auto-generates: booking_POSTGRES_URL (with your database name prefix)
# For local, you can use either name:
POSTGRES_URL=postgresql://user:password@host:5432/database
# OR (if using Vercel naming):
# booking_POSTGRES_URL=postgresql://user:password@host:5432/database

# NextAuth Authentication (Required)
# Generate secret: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here-generate-with-openssl
NEXTAUTH_URL=http://localhost:3000

# Email Service - Resend (Required for bookings)
# Get from: https://resend.com
RESEND_API_KEY=re_your_api_key_here

# Image Upload - UploadThing (Optional - for shop photos)
# Get from: https://uploadthing.com
UPLOADTHING_SECRET=sk_live_your_secret_here
UPLOADTHING_APP_ID=your_app_id_here

# Admin Configuration (Optional)
ADMIN_EMAIL=admin@yourdomain.com
